{
  "name": "training-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/test-workers.mjs && vitest run --config vitest.config.ts",
    "test:desktop": "npm run build && playwright test --config playwright.electron.config.ts",
    "test:runtime": "node scripts/build-runtime.mjs && node scripts/runtime-check.mjs",
    "package:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "test:simulations": "vitest run --config vitest.config.ts tests/simulations"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "^1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "esbuild@0.28.2": true
  }
}
