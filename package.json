{
  "name": "training-monitor",
  "version": "0.1.0",
  "description": "Desktop monitoring for local, WSL, and remote machine learning training jobs.",
  "productName": "Training Monitor",
  "homepage": "https://github.com/Noahxie83/training-monitor",
  "author": {
    "name": "Training Monitor contributors",
    "email": "Noahxie83@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/test-workers.mjs && vitest run --config vitest.config.ts",
    "test:python": "python -B -m unittest discover -s tests -p \"test_*.py\"",
    "test:desktop": "npm run build && playwright test --config playwright.electron.config.ts",
    "test:runtime": "node scripts/build-runtime.mjs && node scripts/runtime-check.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never -c.electronDist=node_modules/electron/dist",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:python && npm run build && npm run test:runtime && npm run test:desktop && npm run package:dir && npm run test:packaged",
    "test:simulations": "vitest run --config vitest.config.ts tests/simulations"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "^1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "esbuild@0.28.2": true
  }
}
