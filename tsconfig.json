{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, "types": ["node", "vite/client"], "resolveJsonModule": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts", "playwright.electron.config.ts", "tests/**/*.ts", "tests/**/*.tsx"]
}
